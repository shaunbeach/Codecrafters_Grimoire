# Dependencies and build output
node_modules/
dist/
dist-ssr/

# Generated by `npm install` (postinstall): the Python runtime, every wheel,
# and the web fonts. About 19 MB. Regenerate with `npm run sync-pyodide` and
# `npm run sync-fonts`.
public/pyodide/
public/fonts/

# Local tooling state: editor settings, AI assistant config, OS files
.vscode/*
!.vscode/extensions.json
.idea/
.claude/
.DS_Store
Thumbs.db

# Logs and local overrides
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local
.env
.env.*

# Screenshots and scratch output from the browser checks
shots*/
*.tmp.mjs
