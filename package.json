{
  "name": "codecrafters-grimoire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-pyodide.mjs && node scripts/sync-fonts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-content-entries.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "sync-pyodide": "node scripts/sync-pyodide.mjs",
    "sync-fonts": "node scripts/sync-fonts.mjs",
    "runtime-check": "node scripts/runtime-check.mjs",
    "verify": "node scripts/verify-modules.mjs",
    "verify:browser": "node scripts/browser-verify.mjs",
    "shell-check": "node scripts/shell-check.mjs",
    "slice-check": "node scripts/slice-check.mjs",
    "smoke": "node scripts/shell-check.mjs",
    "check:timeout": "node scripts/timeout-check.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "check:bundle": "node scripts/bundle-check.mjs",
    "check:prod": "node scripts/prod-check.mjs",
    "gen:content": "node scripts/gen-content-entries.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.10",
    "marked-highlight": "^2.2.4",
    "pyodide": "^314.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "description": "Codecrafter's Grimoire \u2014 a project-based Python course that runs entirely in the browser."
}
